<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
	<RootNamespace>dartwint.DartStash.Server</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<OutputType>Library</OutputType>
	
	<!-- Set these to match your ModMetaData, this ensures the pathing, zip, and assembly version -->
	<ModAuthor>dartwint</ModAuthor>
	<Version>1.0.0</Version>

	<!-- Переключатель: копировать ли сборку в корень SPT -->
	<DeployToSpt Condition="'$(DeployToSpt)' == ''">true</DeployToSpt>

	<!-- The two lines below will set the output path for the binaries -->
	<OutputPath>bin\$(Configuration)\$(ProjectName)\$(AssemblyName)\</OutputPath>
	<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="LoggingSample.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="LoggingSample.cs" />
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="SPTushonka.Common" Version="4.1.6" />
    <PackageReference Include="SPTushonka.DI" Version="4.1.6" />
    <PackageReference Include="SPTushonka.Server.Core" Version="4.1.6" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
	<DebugType>None</DebugType>
	<DebugSymbols>false</DebugSymbols>
	<GenerateDependencyFile>false</GenerateDependencyFile>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <!-- Копирование в корень SPT, только если DeployToSpt=true -->
  <Target Name="DeployToSptFolder" AfterTargets="Build" Condition="'$(DeployToSpt)' == 'true'">
    <PropertyGroup>
	  <!-- Корень SPT: на 3 папки выше файла проекта -->
	  <SptRoot>$(MSBuildProjectDirectory)\..\..\..\</SptRoot>
		
	  <!-- Куда класть DLL внутри SPT -->
	  <SptModDir>$(SptRoot)SPT_Runtime\user\mods\$(ModAuthor)-$(AssemblyName)\</SptModDir>
	</PropertyGroup>

	<MakeDir Directories="$(SptModDir)" />

	<ItemGroup>
	  <DeployFiles Include="$(TargetDir)**\*" />
	</ItemGroup>

	<Copy SourceFiles="@(DeployFiles)" DestinationFiles="@(DeployFiles->'$(SptModDir)%(RecursiveDir)%(Filename)%(Extension)')" />

	<Message Importance="High" Text="Deployed to SPT: $(SptModDir)" />
  </Target>

  <Target Name="ZipRelease" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
	  <ReleaseDirectory>$(MSBuildProjectDirectory)\ReleaseZip\</ReleaseDirectory>
	  <ZipOutput>$(ReleaseDirectory)$(ModAuthor)-$(AssemblyName)-$(Version).zip</ZipOutput>
	  <ZipTempDir>$(IntermediateOutputPath)ReleaseZip\</ZipTempDir>
	</PropertyGroup>

	<!-- Create release directory -->
	<MakeDir Directories="$(ReleaseDirectory)" />

	<!-- Clean and create the temporary folder structure -->
	<RemoveDir Directories="$(ZipTempDir)" />
	<MakeDir Directories="$(ZipTempDir)SPT_Runtime\user\mods\$(ModAuthor)-$(AssemblyName)" />

	<!-- Copy the release DLL into the correct SPT folder -->
	<ItemGroup>
	  <ReleaseFiles Include="$(TargetDir)**\*" />
	</ItemGroup>
	  
	<Copy SourceFiles="@(ReleaseFiles)" DestinationFiles="@(ReleaseFiles->'$(ZipTempDir)SPT_Runtime\user\mods\$(ModAuthor)-$(AssemblyName)\%(RecursiveDir)%(Filename)%(Extension)')" />

	<!-- Create the ZIP -->
	<ZipDirectory SourceDirectory="$(ZipTempDir)" DestinationFile="$(ZipOutput)" Overwrite="true" />

    <Message Importance="High" Text="Created release zip: $(ZipOutput)" />
  </Target>

</Project>
